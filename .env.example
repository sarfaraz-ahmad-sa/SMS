# Public client configuration only. Never put a Supabase secret/service-role
# key or database password in Flutter dart-defines or Vercel client builds.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Supabase is the primary backend in this release. Set this false only when
# deliberately running the Firebase compatibility backend.
ENABLE_SUPABASE_SHADOW=false
ENABLE_SUPABASE_AUTH_PILOT=false
ENABLE_SUPABASE_PRIMARY=true

# Set this to the stable Flutter Web origin before sending account invitations.
SUPABASE_AUTH_REDIRECT_URL=https://your-production-domain.example

# Required by the existing Firebase web client during the transition.
FIREBASE_APPCHECK_RECAPTCHA_KEY=your_public_recaptcha_site_key
FIREBASE_API_KEY=your_firebase_web_api_key
FIREBASE_APP_ID=your_firebase_web_app_id
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app

# Branding: copy config/brand.example.json to an ignored local JSON and use
# --dart-define-from-file=config/local.json. These values are public client data.
