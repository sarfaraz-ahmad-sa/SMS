# Public client configuration only. Never put a Supabase secret/service-role
# key or database password in Flutter dart-defines or Vercel client builds.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Keep false until the Supabase schema, RLS tests, data import, and auth cutover
# are complete. In shadow mode Firebase remains the source of truth.
ENABLE_SUPABASE_SHADOW=false
ENABLE_SUPABASE_AUTH_PILOT=false
ENABLE_SUPABASE_PRIMARY=false

# Set this to the stable Flutter Web origin before sending account invitations.
SUPABASE_AUTH_REDIRECT_URL=https://your-production-domain.example

# Required by the existing Firebase web client during the transition.
FIREBASE_APPCHECK_RECAPTCHA_KEY=your_public_recaptcha_site_key
